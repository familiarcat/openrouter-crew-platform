{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "composite": true,
    "esModuleInterop": true,
    "module": "commonjs",
    "target": "ES2017",
    "lib": ["ES2017", "DOM"],
    "jsx": "react",
    "downlevelIteration": true,
    "skipLibCheck": true
  },
  "references": [
    { "path": "../schemas" }
  ],
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
