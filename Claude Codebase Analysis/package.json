{
  "name": "@openrouter-crew/vscode-extension",
  "displayName": "OpenRouter Crew AI Assistant",
  "description": "AI-powered code assistant with cost optimization",
  "version": "1.0.0",
  "publisher": "openrouter-crew",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Programming Languages"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "openrouter-crew.ask",
        "title": "Ask OpenRouter Crew"
      },
      {
        "command": "openrouter-crew.review",
        "title": "Review Code"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "openrouter-crew-sidebar",
          "title": "OpenRouter Crew",
          "icon": "$(hubot)"
        }
      ]
    },
    "views": {
      "openrouter-crew-sidebar": [
        {
          "id": "openrouter-crew.chat",
          "name": "Chat"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0",
    "vsce": "^2.15.0"
  },
  "dependencies": {
    "@openrouter-crew/crew-api-client": "workspace:*",
    "@openrouter-crew/schemas": "workspace:*",
    "@openrouter-crew/shared-cost-tracking": "workspace:*"
  }
}