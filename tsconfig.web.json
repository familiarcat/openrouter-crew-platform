{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "noEmit": true,
    "isolatedModules": true,
    "allowJs": true,
    "strict": true,
    "composite": false,
    "incremental": false
  },
  "ignoreDeprecations": "5.0"
}
