# OpenRouter Crew Platform local development defaults

# Dashboard / platform
CREW_PLATFORM_URL=http://localhost:3000
OPENROUTER_CREW_PLATFORM_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=local-anon-key
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=local-anon-key
SUPABASE_SERVICE_ROLE_KEY=local-service-role-key
SUPABASE_DB_PASSWORD=postgres

# n8n
N8N_BASE_URL=http://localhost:5678
N8N_WEBHOOK_URL=http://localhost:5678
N8N_API_KEY=local-n8n-api-key
N8N_ENCRYPTION_KEY=local-n8n-encryption-key
N8N_USER=admin
N8N_PASSWORD=admin

# Redis
REDIS_PASSWORD=redis

# Optional remote providers
OPENROUTER_API_KEY=
MCP_URL=http://localhost:3000
MCP_API_KEY=
