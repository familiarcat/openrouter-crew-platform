{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "composite": false,
    "paths": {
      "@/*": [
        "./*"
      ],
      "@crew/*": [
        "../../../domains/shared/crew-api-client/src/*"
      ],
      "@shared/crew-coordination/*": [
        "../../../domains/shared/crew-coordination/src/*"
      ],
      "@shared/cost-tracking/*": [
        "../../../domains/shared/cost-tracking/src/*"
      ],
      "@shared/schemas/*": [
        "../../../domains/shared/schemas/src/*"
      ],
      "@shared/ui-components/*": [
        "../../../domains/shared/ui-components/src/*"
      ]
    },
    "noEmit": true,
    "moduleResolution": "Bundler",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "preserve",
    "baseUrl": "."
  },
  "include": [
    "src/**/*",
    "index.ts"
  ],
  "ignoreDeprecations": "5.0"
}