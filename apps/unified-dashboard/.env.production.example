# apps/unified-dashboard/.env.production.example
#
# All environment variables required for production deployment of the Unified Dashboard.
#
# VERCEL: Set these in Vercel Dashboard → Project Settings → Environment Variables
#         (select "Production" environment for each)
#
# AWS EC2: These are injected by deploy-universal.yml from GitHub Secrets.
#          See scripts/deploy/validate-secrets.sh for the complete secrets checklist.
#
# To get started: copy this to .env.local and fill in values for local development.
#   cp .env.production.example .env.local

# ── Supabase ──────────────────────────────────────────────────────────────────
# Your Supabase project URL (find in: Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Public anon key (find in: Project Settings → API → anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service role key — NEVER expose client-side (find in: Project Settings → API → service_role)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── OpenRouter (Primary LLM Provider) ────────────────────────────────────────
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# ── n8n Workflow Automation ───────────────────────────────────────────────────
# Production n8n URL (EC2 service at: automation.pbradygeorgen.com)
N8N_BASE_URL=https://automation.pbradygeorgen.com
N8N_API_KEY=your-n8n-api-key

# n8n crew webhooks (auto-configured when N8N_BASE_URL is set)
# Override individually only if your crew members have custom webhook paths:
# N8N_CREW_CAPTAIN_PICARD_WEBHOOK=${N8N_BASE_URL}/webhook/crew-captain-picard
# N8N_CREW_COMMANDER_DATA_WEBHOOK=${N8N_BASE_URL}/webhook/crew-commander-data
# ... (10 crew members total)

# ── App URLs ──────────────────────────────────────────────────────────────────
# Set to your Vercel production URL after first deploy
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
SITE_URL=https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# ── AWS (EC2 deploy only — not needed in Vercel) ──────────────────────────────
AWS_REGION=us-east-2

# ── Optional: Additional LLM Providers ───────────────────────────────────────
# Leave blank to use OpenRouter for all calls (recommended)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
