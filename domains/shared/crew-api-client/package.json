{
  "name": "@openrouter-crew/crew-api-client",
  "version": "1.0.0",
  "description": "Unified API client for all Crew Platform surfaces (IDE, CLI, Web, n8n)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "lint": "eslint src",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "@openrouter-crew/agent-memory": "workspace:^",
    "@supabase/supabase-js": "^2.98.0",
    "@types/commander": "^2.12.5",
    "chalk": "^4.1.2",
    "commander": "^12.1.0",
    "uuid": "^9.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@types/uuid": "^9.0.0",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.0.0"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/tests"
    ],
    "testMatch": [
      "**/*.test.ts"
    ],
    "moduleFileExtensions": [
      "ts",
      "js",
      "json"
    ]
  }
}
