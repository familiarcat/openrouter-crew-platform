    {
      "parameters": {
        "command": "=echo \"Executing O'Brien Task: {{ $json.body.taskType }}\"\n\n# Simulating task execution based on input\nif [ \"{{ $json.body.taskType }}\" == \"deploy\" ]; then\n  echo \"Running deployment script...\"\n  # ./scripts/deploy.sh (simulated)\n  echo \"Deployment complete.\"\nelif [ \"{{ $json.body.taskType }}\" == \"maintenance\" ]; then\n  echo \"Running maintenance cleanup...\"\n  # npm run clean (simulated)\n  echo \"Maintenance complete.\"\nelse\n  echo \"Unknown task type: {{ $json.body.taskType }}\"\nfi"
      },
      "id": "execute-command",
      "name": "Execute Command",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [680, 300]
    },
    {
      "parameters": {
        "options": {}
      },
      "id": "respond",
