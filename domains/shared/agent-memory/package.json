{
  "name": "@openrouter-crew/agent-memory",
  "version": "1.0.0",
  "description": "Weighted memory interpolation system for intelligent agent crews",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "type-check": "tsc --noEmit",
    "cli": "node dist/cli.js"
  },
  "bin": {
    "memory-cli": "dist/cli.js"
  },
  "keywords": [
    "memory",
    "interpolation",
    "weighted-graph",
    "neural-networks",
    "agent-coordination"
  ],
  "dependencies": {
    "@openrouter-crew/shared-schemas": "workspace:*",
    "@supabase/supabase-js": "^2.39.0",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^20.11.0",
    "@types/express": "^4.17.17"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  }
}
