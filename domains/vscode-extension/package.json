{
  "name": "@openrouter-crew/vscode-extension",
  "displayName": "OpenRouter Crew AI",
  "description": "Cost-optimized AI coding assistant using OpenRouter",
  "version": "0.1.0",
  "publisher": "openrouter-crew",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Programming Languages"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "openrouter-crew-sidebar",
          "title": "OpenRouter Crew",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "openrouter-crew-sidebar": [
        {
          "id": "openrouter-crew.project-view",
          "name": "Projects"
        },
        {
          "id": "openrouter-crew.crew-view",
          "name": "Crew Roster"
        },
        {
          "id": "openrouter-crew.cost-report",
          "name": "Cost & Budget"
        },
        {
          "id": "openrouter-crew.memory-view",
          "name": "Memories"
        }
      ]
    },
    "commands": [
      {
        "command": "openrouter-crew.resetCost",
        "title": "OpenRouter Crew: Reset Daily Cost Tracker",
        "category": "OpenRouter Crew"
      },
      {
        "command": "openrouter-crew.updateDailyBudget",
        "title": "OpenRouter Crew: Update Daily Budget",
        "category": "OpenRouter Crew"
      },
      {
        "command": "openrouter-crew.analyzeComplexity",
        "title": "OpenRouter Crew: Analyze Text Complexity"
      },
      {
        "command": "openrouter-crew.previewCost",
        "title": "OpenRouter Crew: Preview Cost for Command"
      },
      {
        "command": "openrouter-crew.previewImageCost",
        "title": "OpenRouter Crew: Preview Image Cost (AI)",
        "category": "OpenRouter Crew"
      },
      {
        "command": "openrouter-crew.exportCostReportJson",
        "title": "OpenRouter Crew: Export Cost Report (JSON)",
        "category": "OpenRouter Crew"
      },
      {
        "command": "openrouter-crew.chat",
        "title": "Open Crew Chat (AI)"
      },
      {
        "command": "openrouter-crew.review",
        "title": "Review Code (AI)"
      },
      {
        "command": "openrouter-crew.explain",
        "title": "Explain Code (AI)"
      },
      {
        "command": "openrouter-crew.generate",
        "title": "Generate Code (AI)"
      },
      {
        "command": "openrouter-crew.refactor",
        "title": "Refactor Code (AI)"
      },
      {
        "command": "openrouter-crew.quickFix",
        "title": "Quick Fix Error (AI)"
      },
      {
        "command": "openrouter-crew.structure",
        "title": "Analyze Project Structure (AI)"
      },
      {
        "command": "openrouter-crew.terminal",
        "title": "Run Terminal Command (AI)"
      },
      {
        "command": "openrouter-crew.test",
        "title": "Generate Tests (AI)"
      },
      {
        "command": "openrouter-crew.debug",
        "title": "Debug Code (AI)"
      },
      {
        "command": "openrouter-crew.optimize",
        "title": "Optimize Code (AI)"
      },
      {
        "command": "openrouter-crew.document",
        "title": "Generate Docs (AI)"
      },
      {
        "command": "openrouter-crew.showCostReport",
        "title": "Show Cost Report"
      },
      {
        "command": "openrouter-crew.crew.roster",
        "title": "Show Crew Roster"
      },
      {
        "command": "openrouter-crew.crew.consult",
        "title": "Consult Crew Member"
      },
      {
        "command": "openrouter-crew.memory.create",
        "title": "Create Memory"
      },
      {
        "command": "openrouter-crew.memory.search",
        "title": "Search Memories"
      },
      {
        "command": "openrouter-crew.memory.compliance",
        "title": "Check Memory Compliance"
      },
      {
        "command": "openrouter-crew.explain-terminal",
        "title": "Explain Terminal Error (AI)"
      },
      {
        "command": "openrouter-crew.history",
        "title": "Show Interaction History"
      },
      {
        "command": "openrouter-crew.settings",
        "title": "Open Extension Settings"
      },
      {
        "command": "openrouter-crew.welcome",
        "title": "OpenRouter Crew: Welcome",
        "category": "OpenRouter Crew"
      },
      {
        "command": "openrouter-crew.openCodebaseAnalysis",
        "title": "OpenRouter Crew: Open Codebase Analysis",
        "category": "OpenRouter Crew"
      }
    ],
    "configuration": {
      "title": "OpenRouter Crew",
      "properties": {
        "openrouterCrew.apiKey": {
          "type": "string",
          "description": "OpenRouter API Key"
        },
        "openrouterCrew.model.simple": {
          "type": "string",
          "default": "anthropic/claude-3-haiku-20240307",
          "description": "Model for simple, low-complexity tasks (e.g., short questions)."
        },
        "openrouterCrew.model.default": {
          "type": "string",
          "default": "anthropic/claude-3-sonnet",
          "description": "Default model for medium-complexity tasks."
        },
        "openrouterCrew.model.complex": {
          "type": "string",
          "default": "anthropic/claude-3-sonnet",
          "description": "Model for complex tasks like debugging, refactoring, or optimization."
        },
        "openrouterCrew.model.review": {
          "type": "string",
          "default": "openai/gpt-4-turbo",
          "description": "Specialized model for code reviews, often requiring deeper analysis."
        },
        "openrouterCrew.model.premium": {
          "type": "string",
          "default": "anthropic/claude-3-opus",
          "description": "Premium model for high-complexity tasks and reasoning."
        },
        "openrouterCrew.budget.monthly": {
          "type": "number",
          "default": 10,
          "description": "Monthly budget limit in USD"
        },
        "openrouterCrew.budget.daily": {
          "type": "number",
          "default": 1,
          "description": "Daily budget limit in USD. The cost meter will track usage against this limit."
        }
      }
    }
  },
  "keybindings": [
    {
      "command": "openrouter-crew.chat",
      "key": "ctrl+shift+c",
      "when": "editorTextFocus"
    },
    {
      "command": "openrouter-crew.review",
      "key": "ctrl+shift+r",
      "when": "editorTextFocus"
    },
    {
      "command": "openrouter-crew.explain",
      "key": "ctrl+shift+e",
      "when": "editorTextFocus"
    },
    {
      "command": "openrouter-crew.generate",
      "key": "ctrl+shift+g",
      "when": "editorTextFocus"
    },
    {
      "command": "openrouter-crew.refactor",
      "key": "ctrl+shift+f",
      "when": "editorTextFocus"
    },
    {
      "command": "openrouter-crew.quickFix",
      "key": "ctrl+shift+q",
      "when": "editorTextFocus"
    }
  ],
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js",
    "run-in-browser": "npx @vscode/test-web --extensionDevelopmentPath=.",
    "release": "npm version patch && git push --follow-tags"
  },
  "dependencies": {
    "@openrouter-crew/crew-api-client": "workspace:*",
    "@openrouter-crew/shared-cost-tracking": "workspace:^",
    "@openrouter-crew/shared-crew-coordination": "workspace:^",
    "@openrouter-crew/shared-schemas": "workspace:^",
    "@supabase/supabase-js": "^2.39.0",
    "tesseract.js": "^5.0.0",
    "typescript": "^5.3.3",
    "web-tree-sitter": "^0.20.8"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "20.x",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^2.3.8",
    "@vscode/vsce": "^2.24.0",
    "glob": "^10.3.10",
    "mocha": "^10.2.0"
  }
}