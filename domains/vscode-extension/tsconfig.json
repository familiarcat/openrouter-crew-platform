{
  "compilerOptions": {
    "module": "Node16",
    "target": "ES2020",
    "outDir": "out",
    "lib": [
      "ES2020",
      "DOM"
    ],
    "sourceMap": true,
    "rootDir": "src",
    "strict": true,
    "types": [
      "node",
      "mocha"
    ],
    "ignoreDeprecations": "5.0",
    "moduleResolution": "Node16"
  },
  "exclude": [
    "node_modules"
  ]
}