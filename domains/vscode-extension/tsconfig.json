{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "esModuleInterop": true,
    "composite": false,
    "module": "CommonJS",
    "moduleResolution": "Node",
    "target": "ES2020",
    "outDir": "out",
    "lib": [
      "ES2020",
      "DOM"
    ],
    "types": [
      "node",
      "mocha"
    ],
    "paths": {
      "@openrouter-crew/shared-cost-tracking": [
        "../shared/cost-tracking/src/index.ts"
      ],
      "@openrouter-crew/shared-schemas": [
        "../shared/schemas/src/index.ts"
      ],
      "@openrouter-crew/shared-crew-coordination": [
        "../shared/crew-coordination/src/index.ts"
      ],
      "@openrouter-crew/shared-ui-components": [
        "../shared/ui-components/src/index.ts"
      ],
      "@openrouter-crew/shared-ui-components/*": [
        "../shared/ui-components/src/*"
      ]
    },
    "baseUrl": "."
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "out"
  ]
}
