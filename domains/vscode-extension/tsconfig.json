{
  "compilerOptions": {
    "module": "ESNext",
    "target": "ES2020",
    "outDir": "out",
    "lib": [
      "ES2020",
      "DOM"
    ],
    "sourceMap": true,
    "rootDir": "src",
    "strict": true,
    "types": [
      "node"
    ],
    "ignoreDeprecations": "5.0",
    "moduleResolution": "Bundler"
  },
  "exclude": [
    "node_modules"
  ]
}