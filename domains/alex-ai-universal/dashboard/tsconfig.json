{
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ],
      "@alex-ai/core/controller/mcp-n8n-controller": [
        "./lib/mocks/mcp-n8n-controller.ts"
      ],
      "@crew/*": [
        "../../../domains/shared/crew-api-client/src/*"
      ],
      "@shared/crew-coordination/*": [
        "../../../domains/shared/crew-coordination/src/*"
      ],
      "@shared/cost-tracking/*": [
        "../../../domains/shared/cost-tracking/src/*"
      ],
      "@shared/schemas/*": [
        "../../../domains/shared/schemas/src/*"
      ],
      "@shared/ui-components/*": [
        "../../../domains/shared/ui-components/src/*"
      ],
      "@/scripts/utils/unified-service-accessor": [
        "./lib/mocks/unified-service-accessor.ts"
      ],
      "../../../../types/constructor": [
        "../../../domains/shared/schemas/src/index.ts"
      ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "ignoreDeprecations": "6.0",
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.js",
    "../types/**/*.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}