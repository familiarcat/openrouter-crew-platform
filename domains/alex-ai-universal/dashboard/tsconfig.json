{
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "preserve",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@/*": [
        "./*"
      ],
      "@alex-ai/core/controller/mcp-n8n-controller": [
        "./lib/mocks/mcp-n8n-controller.ts"
      ],
      "@crew/*": [
        "../../../domains/shared/crew-api-client/src/*"
      ],
      "@shared/crew-coordination/*": [
        "../../../domains/shared/crew-coordination/src/*"
      ],
      "@shared/cost-tracking/*": [
        "../../../domains/shared/cost-tracking/src/*"
      ],
      "@shared/schemas/*": [
        "../../../domains/shared/schemas/src/*"
      ],
      "@shared/ui-components/*": [
        "../../../domains/shared/ui-components/src/*"
      ]
    },
    "composite": false,
    "allowJs": true,
    "noEmit": true,
    "isolatedModules": true,
    "strict": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": "."
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "next-env.d.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "scripts"
  ],
  "ignoreDeprecations": "5.0"
}