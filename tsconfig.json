{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/config/*": ["./config/*"],
      "@/lib/*": ["./lib/*"],
      "@/components/*": ["./components/*"],
      "@/utils/*": ["./utils/*"],
      "@/styles/*": ["./styles/*"],
      "@openrouter-crew/shared-schemas/*": ["./domains/shared/schemas/*"],
      "@openrouter-crew/shared-schemas": ["./domains/shared/schemas/src/index"],
      "@openrouter-crew/shared-ui-components/*": ["./domains/shared/ui-components/*"],
      "@openrouter-crew/shared-ui-components": ["./domains/shared/ui-components/src/index"],
      "@openrouter-crew/shared-crew-coordination/*": ["./domains/shared/crew-coordination/*"],
      "@openrouter-crew/shared-crew-coordination": ["./domains/shared/crew-coordination/src/index"],
      "@openrouter-crew/shared-cost-tracking/*": ["./domains/shared/cost-tracking/*"],
      "@openrouter-crew/shared-cost-tracking": ["./domains/shared/cost-tracking/src/index"],
      "@openrouter-crew/crew-api-client/*": ["./domains/shared/crew-api-client/*"],
      "@openrouter-crew/crew-api-client": ["./domains/shared/crew-api-client/src/index"],
      "@openrouter-crew/shared-redis-client": ["./domains/shared/redis-client/src/index"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}