{
  "extends": "../../tsconfig.json", // Extend from the monorepo root tsconfig
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/config/*": ["./config/*"],
      "@/lib/*": ["./lib/*"],
      "@/components/*": ["./components/*"],
      "@/utils/*": ["./utils/*"],
      "@/styles/*": ["./styles/*"],
      "@openrouter-crew/shared-schemas": ["../../domains/shared/schemas"],
      "@openrouter-crew/shared-ui-components": ["../../domains/shared/ui-components"],
      "@openrouter-crew/shared-crew-coordination": ["../../domains/shared/crew-coordination"],
      "@openrouter-crew/shared-cost-tracking": ["../../domains/shared/cost-tracking"],
      "@openrouter-crew/crew-api-client": ["../../domains/shared/crew-api-client"],
      "@openrouter-crew/shared-utils/*": ["../../domains/shared/utils/*"] // Assuming a shared utils package
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}